        "description": "Measures the Student model's prediction uncertainty using six calibrated metrics. All metrics are normalized to [0, 1]. This report is a direct upstream input to SCRS.",
        "configurations": {
            "student_model_path": "D:\\collapse-resistant-training\\checkpoints\\student_model\\best",
